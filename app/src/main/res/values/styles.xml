<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#4778C7</item>
        <item name="android:statusBarColor">#F4F6FA</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:buttonStyle">@style/F12Button</item>
    </style>
    <style name="F12Button" parent="@android:style/Widget.Material.Button">
        <item name="android:textColor">#355D98</item>
        <item name="android:textSize">11sp</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:backgroundTint">#EAF0F9</item>
    </style>
</resources>