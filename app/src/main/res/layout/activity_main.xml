<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#10141D">
<LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:padding="6dp" android:background="#1B2230">
<EditText android:id="@+id/address" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:singleLine="true" android:hint="https://example.com" android:inputType="textUri" android:imeOptions="actionGo" android:textColor="#F3F6FC" android:hintTextColor="#8995A8" android:paddingHorizontal="12dp" android:background="#293345"/>
<Button android:id="@+id/go" android:layout_width="wrap_content" android:layout_height="40dp" android:text="GO"/></LinearLayout>
<WebView android:id="@+id/web" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:background="#1B2230">
<Button android:id="@+id/elements" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Elements"/>
<Button android:id="@+id/console" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Console"/>
<Button android:id="@+id/network" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Network"/>
<Button android:id="@+id/source" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Source"/></LinearLayout>
<TextView android:id="@+id/panelTitle" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:text="INSPECTOR" android:textColor="#79A8FF" android:textStyle="bold" android:background="#202A3A"/>
<ScrollView android:id="@+id/panelScroll" android:layout_width="match_parent" android:layout_height="180dp" android:background="#151C28">
<TextView android:id="@+id/panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:textColor="#D8E0EE" android:textSize="12sp" android:text="Load a page, then choose a panel."/></ScrollView></LinearLayout>
